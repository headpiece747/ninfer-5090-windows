#!/bin/sh
# Eleven checks, all seconds: documentation links resolve, documentation citations still point
# inside the files they name, tracked text is byte-preserved UTF-8, the
# profile tables match the profile module and the generated launchers, the calibration corpus is
# still the one the artifact's creator used, the set of production functions defaulting a CUDA stream
# has not widened, no first-party type is declared and never named again, no copy-paste has been
# added past the recorded baseline, no divergence from upstream inside an upstream-owned
# file has gone unrecorded, and the converter tests
# pass. Each has caught a real drift in this repository --
# a README quoting a digest the pins had moved past, 181 lines of documentation re-encoded by a
# scripted edit while every other gate still passed, a suite size that had drifted from the baseline,
# a recipe defect, a block scale that one of its three carriers had moved without the others, a KV
# block-table publish left unordered against the compute stream, a declared type nothing could reach --
# and before this hook existed,
# nothing ran them automatically.
#
# Deliberately not here: the C++ suite (minutes, and it needs the GPU), the baseline gate (it runs
# ctest), compute-sanitizer (much slower again), and the Op perturbation gate. Those belong at a
# push or in CI, which is why tools/scripts/test_v3.cmd and tools/scripts/test_v3_compute_sanitizer.cmd
# exist.
#
# The perturbation gate was in this hook once and was removed deliberately, because it reads a build
# artifact rather than source. Every check here reads tracked files, so it is current by
# construction; that one ran ctest against whatever binary happened to be in build-test, and with the
# kernel edited but not rebuilt it reported PASS -- a false green, which is worse than no check,
# since it turns an untested commit into an apparently tested one. It now builds what it perturbs
# and runs at the tail of test_v3.cmd, where "freshly built" is a precondition rather than a hope.
# What survives here is the manifest half: 19 tests that validate the declarations with no build and
# no GPU, which is the drift most likely to happen and the hardest to notice.
#
# Enable with: git config core.hooksPath .githooks
# Skip once with: git commit --no-verify
set -e
PY="${NINFER_PYTHON:-C:/vllm-env/Scripts/python.exe}"
root="$(git rev-parse --show-toplevel)"
cd "$root"

# The interpreter may be a command on PATH or a path to a file, and the two need different tests:
# `-x` asks whether a *file* is executable, so it rejects "python" and accepted only the local
# path -- which is why every CI run failed on this line while every local commit passed.
if command -v "$PY" >/dev/null 2>&1; then
    :
elif [ -x "$PY" ]; then
    :
else
    echo "pre-commit: python not found at $PY (set NINFER_PYTHON to override)" >&2
    exit 1
fi
echo "pre-commit: interpreter $PY"

# A gate is run through this so a failure shows its reason. The two gates that print a report are
# quiet when they agree, which is what keeps a commit clean, but their output used to be discarded
# outright -- so a gate that *crashed* rather than disagreed produced one silent line and no
# explanation, and five CI runs failed that way with nothing to read.
gate() {
    label="$1"
    shift
    echo "pre-commit: $label"
    output="$("$@" 2>&1)" || {
        status=$?
        echo "pre-commit: $label failed" >&2
        printf '%s\n' "$output" | tail -40 >&2
        exit "$status"
    }
}

gate "documentation links" "$PY" tools/release/check_doc_links.py
gate "documentation citations" "$PY" tools/release/check_doc_citations.py
gate "text encoding" "$PY" tools/release/check_text_encoding.py
gate "FP8 band ladders" "$PY" tools/release/check_fp8_band_ladders.py
gate "profile consistency" "$PY" tools/release/check_profile_consistency.py
gate "calibration corpus" "$PY" tools/release/check_calibration_corpus.py
gate "stream-default ratchet" "$PY" tools/release/check_production_stream_defaults.py
gate "rule count" "$PY" tools/release/check_rule_count.py
gate "dead types" "$PY" tools/release/check_dead_types.py
gate "new duplication" "$PY" tools/release/check_duplication.py
# The upstream remote is a local-only ref: actions/checkout clones origin alone, so CI has no
# upstream/master and the gate would fail there on a machine that cannot fetch it. Skip loudly,
# the way the opencode plugin check skips without node, rather than failing every CI commit.
if git rev-parse --verify --quiet upstream/master >/dev/null; then
    gate "port delta" "$PY" tools/release/check_port_delta.py --check
else
    echo "pre-commit: SKIPPED port delta -- upstream/master is not a local ref (run: git fetch upstream)"
fi
# The two opencode plugins in .opencode/plugins/ resolve @opencode/plugin from a local node_modules,
# which is deliberately not committed (139 MiB). opencode SKIPS a plugin that fails to load rather than
# crashing, so a missing install is silent: both plugins sat in the tree through one commit, passing
# their logic tests and never having run, because those tests stubbed the very package that failed to
# resolve. Node is not a dependency of this product -- these plugins shape an agent's behaviour and
# nothing about the shipped engine -- so its absence skips loudly here rather than failing every commit
# for a C++ contributor, while its presence makes a missing install a hard failure.
if command -v node >/dev/null 2>&1; then
    gate "opencode plugin load" node --experimental-strip-types tools/opencode/test_plugin_loads.mjs
else
    echo "pre-commit: SKIPPED opencode plugin load -- node not on PATH (npm install --prefix .opencode/plugins)"
fi
echo "pre-commit: converter tests"
# The doc-link test is named explicitly: tests/release also holds a ctest script that exits at import,
# so collecting the directory would abort the run instead of adding to it. The calibration-corpus and
# perturbation tests are named for the same reason, and because a gate whose failure paths have never
# been run is indistinguishable from one that always passes.
"$PY" -m pytest tests/convert tests/release/test_doc_links.py tests/release/test_text_encoding.py tests/release/test_calibration_corpus.py tests/release/test_test_mutation.py -q
echo "pre-commit: ruff"
"$PY" -m ruff check tools tests --quiet
echo "pre-commit: mypy"
"$PY" -m mypy tools/release tools/convert tests
echo "pre-commit: ok"
