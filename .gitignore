# Build
build/
build-*/
cmake-build-*/
*.o
*.obj
*.pdb
*.so
*.a
compile_commands.json
CMakeUserPresets.json
.cache/

# CUDA / profiling artifacts
*.nsys-rep
*.ncu-rep
*.qdrep
*.sqlite

# Python tooling
__pycache__/
*.pyc
.pytest_cache/
.venv/
.venv-test/
venv/
*.egg-info/

# Weight artifacts (large; produced by offline tooling)
*.qus
*.bin
*.safetensors
*.gguf
*.ninfer
*.ninfer.conversion.json
/models/
out/

# Local workspace and transient runtime output
/.agent-tmp/
/.local/
/temp/
/temp-*/
/tmp/
/tmp-*/
/AGENTS.override.md
/logs/
*.log
*.tmp
/core
/core.*

# Measurement raw corpora & intermediates (large; produced by offline tooling).
# The small final frequency stats under fixtures/ranking/ ARE tracked; the rest is ignored.
tools/freq_corpus/fixtures/*
!tools/freq_corpus/fixtures/ranking/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
profiles/
.jscpd-report/
.chatgpt/

# Agent tooling: project-local, not part of this port. Upstream has no .opencode at all,
# and 16,000 lines of vendored skills is not a Windows-port concern. Kept on disk and
# untracked so the skills still load; `git checkout pre-trim-2026-10-13 -- .opencode`
# restores them into the index if that decision is reversed.
.opencode/

# Claude Code personal/local settings (may contain API tokens)
.claude/settings.local.json

# Local Windows build assets
ffmpeg/
jpeg/
*.dll
test_image.png

# CodeGraph index - local to each machine
.codegraph/

# desloppify scan state - its own tool state, and a 3 MB index per language, not project content
.desloppify/

# Local startup configuration; retain the reference and deployment examples.
*.toml
!/ninfer.example.toml
!/ruff.toml
!/examples/configs/*.toml
